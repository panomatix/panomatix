{
  "name": "panomatix-web",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative editor and REST API for the Panomatix road-sign database",
  "type": "module",
  "engines": { "node": ">=24.7" },
  "scripts": {
    "start": "node server/main.js",
    "dev": "PANOMATIX_ENV=development node --watch server/main.js",
