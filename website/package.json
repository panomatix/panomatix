{
  "name": "panomatix-web",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative editor and REST API for the Panomatix road-sign database",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "start": "node server/main.js",
    "dev": "PANOMATIX_ENV=development node --watch server/main.js",
    "import": "node server/cli.js import",
    "export": "node server/cli.js export",
    "create-user": "node server/cli.js create-user",
    "test": "node --test \"test/**/*.test.js\"",
    "backup": "node server/cli.js backup",
    "restore": "node server/cli.js restore",
    "deploy": "sh scripts/deploy.sh"
  },
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "flag-icons": "^7.6.0",
    "nodemailer": "^10.6.1",
    "sharp": "^0.35.5"
  }
}
